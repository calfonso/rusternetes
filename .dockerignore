# Git
.git
.gitignore

# Build artifacts
target/
# Re-include host-built binaries used by Dockerfile.local-binary.services
!target/release/api-server
!target/release/kubelet
!target/release/scheduler
!target/release/controller-manager
!target/release/kube-proxy
# Note: Cargo.lock is needed for reproducible builds in containers
# So we don't exclude it here

# Documentation
*.md
PROGRESS.md
SESSION_SUMMARY.md

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Development files
.env
.env.local

# CI/CD
.github/

# Claude
.claude/

# Runtime cluster state (certs, manifests, pod volumes) — never part of an image
# build context; pod-created volume dirs are root-owned 0700 and break context send.
.rusternetes/
